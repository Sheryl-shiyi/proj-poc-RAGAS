# Gemma-4-31B-IT — HuggingFace pull, 4x A10G (g5.12xlarge)
# Dense 31B, Apache 2.0, no HF token required
# https://huggingface.co/google/gemma-4-31B-it
#
# VRAM budget (per GPU): 22.5GB * 0.8 = 18GB available
# Weights (per GPU):     31B * 2 bytes / 4 GPUs = ~15.5GB
# KV cache headroom:     ~2.5GB per GPU — tight but workable

STORAGE_MODE=hf
MODEL_NAME=gemma-4-31b-it
DISPLAY_NAME=Gemma-4-31B-IT
NAMESPACE=vszp
MODEL_TYPE=generative

# HuggingFace model
STORAGE_URI=hf://google/gemma-4-31B-it
RUNTIME_NAME=vllm-community

# Hardware
HARDWARE_PROFILE=nvidia-l40s-gpu-12xl
GPU_COUNT=4
CPU_LIMIT=20
CPU_REQUEST=18
MEMORY_LIMIT=120Gi
MEMORY_REQUEST=96Gi

# vLLM args (JSON array)
VLLM_ARGS='["--tensor-parallel-size=4", "--dtype=bfloat16", "--max-model-len=11000", "--gpu-memory-utilization=0.90", "--max-num-seqs=32", "--max-num-batched-tokens=4096", "--limit-mm-per-prompt={\"image\":0,\"audio\":0}", "--served-model-name=Gemma-4-31B-IT"]'
