# Gemma-3-27B BF16 Distributed (4x GPU, tensor parallel)
# Currently used as the RAG LLM in experiment1

MODEL_NAME=gemma-3-27b-bf16-distributed
DISPLAY_NAME=Gemma-3-27B-BF16-Distributed
NAMESPACE=vszp
MODEL_TYPE=generative

# S3 connection (Secret + ServiceAccount)
S3_CONNECTION_NAME=models
S3_DISPLAY_NAME=Models
SERVICE_ACCOUNT=models-sa
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_S3_BUCKET=models
AWS_S3_ENDPOINT=https://minio-api-minio.apps.cluster-5pzpt.5pzpt.sandbox1134.opentlc.com
AWS_DEFAULT_REGION=none

# Model path in S3 bucket
S3_MODEL_PATH=/google/gemma-3-27b-it

# Hardware
HARDWARE_PROFILE=nvidia-l40s-gpu-12xl
GPU_COUNT=4
CPU_LIMIT=20
CPU_REQUEST=18
MEMORY_LIMIT=180Gi
MEMORY_REQUEST=160Gi
SHM_SIZE=8Gi

# vLLM image
VLLM_IMAGE=registry.redhat.io/rhaiis/vllm-cuda-rhel9@sha256:ad756c01ec99a99cc7d93401c41b8d92ca96fb1ab7c5262919d818f2be4f3768

# vLLM args (JSON array)
VLLM_ARGS='["--tensor-parallel-size=4", "--dtype=bfloat16", "--max-model-len=11000", "--gpu-memory-utilization=0.8", "--max-num-seqs=32", "--served-model-name=Gemma-3-27B-BF16-Distributed", "--enable-auto-tool-choice", "--tool-call-parser=hermes"]'
