# EuroLLM-22B-Instruct — HuggingFace pull, 4x A10G (g5.12xlarge)
# Dense 22B, Apache 2.0, EU languages (35 languages incl. Slovak)
# https://huggingface.co/utter-project/EuroLLM-22B-Instruct-2512
#
# VRAM budget (per GPU): 22.5GB * 0.8 = 18GB available
# Weights (per GPU):     22B * 2 bytes / 4 GPUs = ~11GB
# KV cache headroom:     ~7GB per GPU

STORAGE_MODE=hf
MODEL_NAME=eurollm-22b
DISPLAY_NAME=EuroLLM-22B-Instruct
NAMESPACE=vszp
MODEL_TYPE=generative

# HuggingFace model
STORAGE_URI=hf://utter-project/EuroLLM-22B-Instruct-2512
RUNTIME_NAME=vllm-gpu

# Hardware — must use tp=4, single A10G (22.5GB) too small for 22B BF16
HARDWARE_PROFILE=nvidia-l40s-gpu-12xl
GPU_COUNT=4
CPU_LIMIT=20
CPU_REQUEST=18
MEMORY_LIMIT=96Gi
MEMORY_REQUEST=80Gi

# vLLM args (JSON array)
VLLM_ARGS='["--tensor-parallel-size=4", "--dtype=bfloat16", "--max-model-len=11000", "--gpu-memory-utilization=0.8", "--max-num-seqs=32", "--served-model-name=EuroLLM-22B-Instruct"]'
