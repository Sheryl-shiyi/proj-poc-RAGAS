# Qwen3-32B — HuggingFace pull, 4x A10G (g5.12xlarge)
# Dense 32B, Apache 2.0, no HF token required
# https://huggingface.co/Qwen/Qwen3-32B
#
# VRAM budget (per GPU): 22.5GB * 0.8 = 18GB available
# Weights (per GPU):     32B * 2 bytes / 4 GPUs = ~16GB
# KV cache headroom:     ~2GB per GPU — TIGHT, may need to reduce max-model-len

STORAGE_MODE=hf
MODEL_NAME=qwen3-32b
DISPLAY_NAME=Qwen3-32B
NAMESPACE=vszp
MODEL_TYPE=generative

# HuggingFace model
STORAGE_URI=hf://Qwen/Qwen3-32B
RUNTIME_NAME=vllm-gpu

# Hardware — 32B BF16 on 4x A10G is tight (~2GB KV cache per GPU)
HARDWARE_PROFILE=nvidia-l40s-gpu-12xl
GPU_COUNT=4
CPU_LIMIT=20
CPU_REQUEST=18
MEMORY_LIMIT=120Gi
MEMORY_REQUEST=96Gi

# vLLM args (JSON array)
VLLM_ARGS='["--tensor-parallel-size=4", "--dtype=bfloat16", "--max-model-len=11000", "--gpu-memory-utilization=0.8", "--max-num-seqs=32", "--served-model-name=Qwen3-32B"]'
